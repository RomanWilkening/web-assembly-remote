# Remote Desktop Server Configuration

[auth]
# Login credentials for the web interface.
# Change these values before deploying!
username = "admin"
password = "changeme"

# Audio output device for loopback capture (optional).
#
# Available audio output devices are auto-discovered and listed in the
# browser toolbar.  The user can select which output device to capture.
#
# Set this to auto-start capturing a specific device when a client
# connects.  Use "default" to capture the system default output.
# Leave commented out to let the user choose manually.
#
# On Windows this uses WASAPI loopback – no "Stereo Mix" or virtual
# audio cable required.  Any audio playing through the selected
# output device is streamed to the browser automatically.
#
# On Linux this uses PulseAudio (monitor sources capture output audio).
#
# Examples:
#   audio_device = "default"
#   audio_device = "Speakers (Realtek High Definition Audio)"
#
# audio_device = ""

# ─────────────────────────────────────────────────────────────────────
# Optional sections — all values shown are defaults.  Anything not set
# here falls back to the corresponding CLI flag default.  CLI flags
# always override config-file values.
# ─────────────────────────────────────────────────────────────────────

# [server]
# host = "0.0.0.0"
# port = 9090
# static_dir = "./static"

# [capture]
# default_monitor = 0
# # capture_backend = "scrap"   # also accepts "wgc" (stub) or "dxgi" (reserved)

# [encoder]
# # When auto_select = true the server probes which encoders work on
# # this machine at startup and picks a sensible default.  When false
# # the configured profile / CLI encoder is used as-is.
# auto_select = true
# default_profile = "office"

# [encoder.profiles.gaming]
# encoder      = "h264_amf"
# codec        = "h264"        # h264 | hevc | av1 (auto-detected from encoder)
# fps          = 60
# quality      = 18
# bitrate_kbps = 12000
# slices       = 4
# chroma       = "420"         # 420 | 444

# [encoder.profiles.office]
# encoder = "libx264"
# fps     = 30
# quality = 24

# [audio]
# default_device = "default"
# sample_rate    = 48000
# channels       = 2

# [logging]
# level = "info"               # trace | debug | info | warn | error
# # file  = "wasm-remote.log"
